# KloguBizz backend configuration.
#
# Copy to `.env` for local work. For a real deployment set these in the host's
# dashboard instead — Render, in this project's case — so no secret ever lands
# in a file that could be committed.
#
# `src/config/env.js` refuses to boot in production on anything in the REQUIRED
# block below, and warns loudly on the rest. Read docs/LAUNCH-READINESS.md before
# a first production deploy: several of these are one-way doors.

# ── REQUIRED in production — the server will not start without them ──

NODE_ENV=development
PORT=5000

# The connection string. In production the server refuses to start without it,
# rather than quietly trying a local database that does not exist.
MONGO_URI=mongodb://localhost:27017/klogubizz

# At least 32 random characters, and different from each other. A known
# JWT_SECRET is the ability to mint a token for any account, including a
# platform owner. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_very_long_access_token_secret
JWT_REFRESH_SECRET=replace_with_a_different_refresh_token_secret

# ── SET THIS BEFORE ANYONE ENROLS IN 2FA. It cannot be changed afterwards. ──
#
# Encrypts TOTP secrets and tenants' stored payment-gateway credentials at rest.
# Left empty it falls back to JWT_SECRET — which works, and is a trap: rotating
# JWT_SECRET later then makes every enrolled authenticator and every stored
# gateway credential permanently undecryptable. Not "sessions end"; unrecoverable
# without re-enrolling every user by hand.
#
# Generate once, store in a password manager, never rotate.
MFA_ENCRYPTION_KEY=

# ── Where the frontend lives ──
#
# CORS allowlist. Comma-separated, so apex + www + a preview domain can all
# reach the API. Without it only http://localhost:4200 is allowed, and the
# deployed frontend cannot call the API at all.
FRONTEND_URL=http://localhost:4200

# ── The platform owner account ──
#
# Read by `npm run bootstrap` (and `npm run seed`), both of which refuse to
# create the account with the documented default below. After the first run the
# real credential is the hash in Mongo, rotated in-app — changing this variable
# later does nothing.
#
# Use `npm run bootstrap` to prepare a production database. `npm run seed` wipes
# every collection and inserts a demo tenant using a password published in this
# repository; it is for developer machines only.
SUPER_ADMIN_EMAIL=superadmin@klogubizz.local
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Comma-separated IPs or CIDR blocks allowed to reach /api/v1/superadmin.
# Empty means no restriction.
SUPERADMIN_IP_ALLOWLIST=

# Whether a platform account must enrol in MFA before using the console.
# Defaults to on in production, off locally. Leave unset unless you have a reason.
REQUIRE_SUPERADMIN_MFA=

# ── Payments (Razorpay) ──
#
# Without both keys, paid plan changes are REFUSED in production rather than
# activated — deliberately, since the alternative is giving the plan away.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Once the keys above are set, a default webhook secret is a hard boot error:
# a forged `subscription.charged` would upgrade any account for free.
RAZORPAY_WEBHOOK_SECRET=local_webhook_secret

# ── Email (SendGrid) ──
#
# Without the API key every send is recorded as "skipped" and nothing leaves —
# invites, payment reminders and the whole dunning sequence silently do nothing.
# A consequence worth knowing: dunning never auto-suspends anyone when no mail
# provider is configured, because no send ever counts as delivered.
SENDGRID_API_KEY=
FROM_EMAIL=invoices@klogubizz.local

# The events webhook, so a bounced address is suppressed rather than retried
# forever. Without it the route refuses every request: an unauthenticated
# endpoint that writes delivery state is one anyone could use to mark a
# competitor's address as bounced.
SENDGRID_WEBHOOK_SECRET=

# ── Image storage ──
#
# inline (default) | local | s3
#
# `local` on an ephemeral filesystem (Render, Heroku, most containers) loses
# every uploaded logo and signature on the next deploy, silently. Use `s3` in
# production — the driver speaks the S3 API, so Cloudflare R2, Backblaze B2 and
# MinIO all work.
STORAGE_DRIVER=inline
STORAGE_LOCAL_DIR=var/uploads
S3_BUCKET=
S3_REGION=auto
# Set for any S3-compatible store that is not AWS. Leave empty for real S3.
S3_ENDPOINT=
# R2 and MinIO address buckets by path, not by virtual host.
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── E-invoicing (IRN + signed QR) ──
#
# All five are needed before an invoice is reported to the IRP. With any missing,
# the service still validates and builds the payload but refuses to pretend it
# was filed. Mandatory above a turnover threshold — know whether your customers
# cross it. The provider adapter itself is a stub: see
# services/eInvoiceService.js#callIrp.
IRP_BASE_URL=
IRP_USERNAME=
IRP_PASSWORD=
IRP_CLIENT_ID=
IRP_CLIENT_SECRET=

# ── E-way bills ──
#
# Mandatory above a consignment value. Same shape as e-invoicing: everything
# around the call is real and tested, and the call itself is a stub — see
# services/ewayBillService.js#callEwbApi.
EWB_BASE_URL=
EWB_USERNAME=
EWB_PASSWORD=

# ── Optional tuning. The defaults are sensible; change only with a reason. ──

# How long a soft-deleted record stays recoverable before the hourly sweep
# erases it. Default 30.
SOFT_DELETE_GRACE_DAYS=

# Retention windows, in days.
AUDIT_RETENTION_DAYS=
EMAIL_LOG_RETENTION_DAYS=
USAGE_EVENT_RETENTION_DAYS=

# The B2C large-invoice threshold used by GSTR-1. Default 250000.
GST_B2CL_THRESHOLD=

# json (default in production) | pretty
LOG_FORMAT=
LOG_LEVEL=info

# Whether an unverified email address blocks writes. Defaults to on only when
# SENDGRID_API_KEY is set — requiring verification with no way to send it would
# make the app unusable.
EMAIL_VERIFICATION_ENFORCED=
