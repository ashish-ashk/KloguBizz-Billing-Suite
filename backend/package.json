{
  "name": "klogubizz-backend",
  "version": "0.1.0",
  "description": "KloguBizz GST billing SaaS API",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node src/seed/seed.js",
    "test": "node --test",
    "migrate": "node src/migrations/runner.js",
    "migrate:status": "node src/migrations/runner.js status",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"src/**/*.js\" \"test/**/*.js\" server.js",
    "format:write": "prettier --write \"src/**/*.js\" \"test/**/*.js\" server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@sendgrid/mail": "^8.1.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.3",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.4",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
